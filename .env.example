# Copy this file to .env and fill in your own key. The real .env is
# gitignored and must NEVER be committed.
# Get a free key at https://console.groq.com (no credit card needed).
GROQ_API_KEY=

# Optional - cloud memory. Free project at https://supabase.com:
# Project Settings > API: URL and the "anon public" key.
# Leave these blank and Athena works fine, just without long-term memory.
SUPABASE_URL=
SUPABASE_KEY=

# Optional - live web research (look_up / research skills). Free key at
# https://app.tavily.com. Without it those skills say they can't reach the web.
TAVILY_API_KEY=

# Optional - Google Docs + Gmail. These are OAuth client credentials, not an
# API key. At https://console.cloud.google.com: create a project, enable the
# Google Docs, Google Drive and Gmail APIs, set the OAuth consent screen to
# External and add yourself as a test user, then create an OAuth client ID of
# type "Desktop app" and paste its two values here.
# Then run:  python google_auth_test.py   (one-time browser sign-in)
# Note: while the app is in Testing mode Google expires the sign-in after
# 7 days, so re-run that test script if the document/email skills stop working.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional - Gemini, used ONLY for spreadsheet reasoning. Sheet data is
# token-heavy and Groq's free tier caps at 12,000 tokens a minute, so you can
# move just that one call off Groq. Free key at https://aistudio.google.com.
# Set SHEETS_PROVIDER=gemini to switch it on; anything else keeps it on Groq.
# Without a key it silently stays on Groq, so this is safe to leave blank.
GEMINI_API_KEY=
SHEETS_PROVIDER=groq

# Optional - the provider fallback chain. When one provider's rate limit is
# hit, Athena falls through to the next instead of failing. All of these are
# free tiers and all speak the OpenAI API shape.
#   groq        llama-3.3-70b-versatile  30 RPM, 1,000 RPD, 12K TPM, 100K TPD
#   gemini      gemini-2.5-flash         limits vary - see AI Studio
#   mistral     mistral-small-latest     1 req/sec, 500K TPM, 1B tokens/month
#   nvidia_nim  llama-3.3-70b-instruct   ~40 RPM
#   groq_small  llama-3.1-8b-instant     30 RPM, 14,400 RPD, 6K TPM
#
# Groq's limits are per ORGANISATION, not per key - a second Groq key on the
# same account buys you nothing, so don't bother.
#
# PRIVACY: the Gemini and Mistral FREE tiers may use what you send to train
# their models. Don't route document or spreadsheet content through them.
#
# Free keys: https://aistudio.google.com  |  https://console.mistral.ai
#            https://build.nvidia.com
MISTRAL_API_KEY=
NVIDIA_API_KEY=
# Set to 1 to turn the chain on. Off means Groq only, exactly as before.
PROVIDER_FALLBACK_ENABLED=