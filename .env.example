# Copy this file to .env and fill in your own key. The real .env is
# gitignored and must NEVER be committed.
# Get a free key at https://console.groq.com (no credit card needed).
GROQ_API_KEY=

# Optional - cloud memory and calendar follow-ups. Free project at
# https://supabase.com: Project Settings > API: URL and the "anon public" key.
# Leave these blank and Athena works fine - she just doesn't remember across
# sessions and doesn't follow up on events whose time has passed.
#
# A fresh project needs BOTH tables. The SQL for each is in that module's
# docstring; paste both into the Supabase SQL editor:
#   interactions   - athena/memory.py         (conversation memory)
#   event_status   - athena/event_status.py   (what happened to an event)
# Check them with:  python memory_test.py  and  python event_status_test.py
#
# Note: a free project that sits idle is paused, and eventually removed. If
# these stop working, check the dashboard - a new project means a new URL and
# key here, and both tables created again.
SUPABASE_URL=
SUPABASE_KEY=

# Optional - live web research (look_up / research skills). Free key at
# https://app.tavily.com. Without it those skills say they can't reach the web.
TAVILY_API_KEY=

# Optional - Google Docs, Gmail, Sheets and Calendar. These are OAuth client
# credentials, not an API key. At https://console.cloud.google.com: create a
# project, enable the Google Docs, Google Drive, Gmail, Google Sheets and
# Google Calendar APIs, set the OAuth consent screen to External and add
# yourself as a test user, then create an OAuth client ID of type
# "Desktop app" and paste its two values here.
# Then run:  python google_auth_test.py   (one-time browser sign-in)
# Adding a permission later invalidates the cached sign-in on purpose, so
# after any change to google_auth.SCOPES run:
#   python google_auth_test.py --reset    then sign in again.
# Note: while the app is in Testing mode Google expires the sign-in after
# 7 days, so re-run that test script if the document/email skills stop working.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional - Gemini, used ONLY for spreadsheet reasoning. Sheet data is
# token-heavy and Groq's free tier caps at 12,000 tokens a minute, so you can
# move just that one call off Groq. Free key at https://aistudio.google.com.
# Set SHEETS_PROVIDER=gemini to switch it on; anything else keeps it on Groq.
# Without a key it silently stays on Groq, so this is safe to leave blank.
GEMINI_API_KEY=
SHEETS_PROVIDER=groq